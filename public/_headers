# Security headers for Cloudflare Pages
# Applied to all routes

# Next.js RSC payload files - every page gets a .txt twin (about.txt, sermons/<slug>.txt)
# carrying the full page content with no canonical and no noindex. Google crawled them
# and flagged "Duplicate without user-selected canonical" (Search Console, 2026-07-03).
# noindex keeps them out of the index without blocking fetching, so the IndexNow key
# file and llms.txt stay readable by the bots that need them.
/*.txt
  X-Robots-Tag: noindex

# Utility apps - secret-link tools, not for search results
# /app/ is the member front door - shared in the church WhatsApp, installable,
# no search value (it is a menu of links), so noindex keeps it out of Google
# without blocking the WhatsApp link preview.
/app/
  X-Robots-Tag: noindex
/app/*
  X-Robots-Tag: noindex
/WA/
  X-Robots-Tag: noindex
/WA/*
  X-Robots-Tag: noindex
/attendance/
  X-Robots-Tag: noindex
/attendance/*
  X-Robots-Tag: noindex
/tiktok/
  X-Robots-Tag: noindex
/tiktok/*
  X-Robots-Tag: noindex
/wired/
  X-Robots-Tag: noindex
/wired/*
  X-Robots-Tag: noindex
/serve/
  X-Robots-Tag: noindex
/serve/*
  X-Robots-Tag: noindex

